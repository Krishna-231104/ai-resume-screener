version: '3.0'
containerDefinitions:
  - name: ai-resume-server
    image: {AWS_ACCOUNT}.dkr.ecr.{REGION}.amazonaws.com/ai-resume-server:latest
    portMappings:
      - containerPort: 5000
        hostPort: 5000
        protocol: tcp
    environment:
      - name: MONGODB_URI
        value: mongodb+srv://{DB_USER}:{DB_PASS}@{DB_HOST}/ai-resume-screener
      - name: JWT_SECRET
        valueFrom: arn:aws:secretsmanager:{REGION}:{AWS_ACCOUNT}:secret:ai-resume/jwt-secret
      - name: GROQ_API_KEY
        valueFrom: arn:aws:secretsmanager:{REGION}:{AWS_ACCOUNT}:secret:ai-resume/groq-key
      - name: EMAIL_USER
        valueFrom: arn:aws:secretsmanager:{REGION}:{AWS_ACCOUNT}:secret:ai-resume/email-user
      - name: EMAIL_PASSWORD
        valueFrom: arn:aws:secretsmanager:{REGION}:{AWS_ACCOUNT}:secret:ai-resume/email-pass
      - name: CLIENT_URL
        value: https://yourdomain.com
      - name: PORT
        value: '5000'
    logConfiguration:
      logDriver: awslogs
      options:
        awslogs-group: /ecs/ai-resume-server
        awslogs-region: {REGION}
        awslogs-stream-prefix: ecs

  - name: ai-resume-client
    image: {AWS_ACCOUNT}.dkr.ecr.{REGION}.amazonaws.com/ai-resume-client:latest
    portMappings:
      - containerPort: 5173
        hostPort: 5173
        protocol: tcp
    environment:
      - name: VITE_API_URL
        value: https://api.yourdomain.com
    logConfiguration:
      logDriver: awslogs
      options:
        awslogs-group: /ecs/ai-resume-client
        awslogs-region: {REGION}
        awslogs-stream-prefix: ecs

family: ai-resume-screener
networkMode: awsvpc
requiresCompatibilities:
  - FARGATE
cpu: '512'
memory: '1024'
executionRoleArn: arn:aws:iam::{AWS_ACCOUNT}:role/ecsTaskExecutionRole
taskRoleArn: arn:aws:iam::{AWS_ACCOUNT}:role/ecsTaskRole
